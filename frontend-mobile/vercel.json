{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://sadar-finance.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://sadar-finance.up.railway.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
