# ────────────────────────────────────────────────────────────
# SADAR Finance API — Environment Configuration
# ────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sadar_finance
DB_USER=postgres
# Isi dengan password PostgreSQL lokal kamu.
# Jika PostgreSQL lokal tanpa password, biarkan kosong.
DB_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# AI Service (Python microservice)
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_TIMEOUT_MS=10000
AI_MOCK_MODE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
