# Skenario data SADAR:
# mock-with-backend-auth = login backend, data finansial memakai mock frontend
# backend-with-backend-auth = login backend, data finansial dari backend user login
# backend-only = semua auth dan data dari backend, tanpa mock
VITE_SADAR_DATA_SCENARIO=backend-only
